VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Opcional: app antigo CloudApp (sem equipe/blocos)
# VITE_LEGACY_CLOUD_APP=1

# Edge Functions / server only (NÃO coloque no Vite frontend):
# SUPABASE_SERVICE_ROLE_KEY=
# PIX_WEBHOOK_SECRET=change-me
# PIX_PROVIDER=mock
#
# --- Sicoob PIX ---
# PIX_PROVIDER=sicoob
# SICOOB_ENV=homol
# SICOOB_CLIENT_ID=
# SICOOB_PIX_KEY=sua-chave-pix@email.com
# SICOOB_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# SICOOB_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Opcional: SICOOB_CLIENT_SECRET=  (algumas apps pedem)
# Opcional: SICOOB_ACCESS_TOKEN=   (só teste manual)
# Opcional: PIX_WEBHOOK_REQUIRE_SECRET=1
